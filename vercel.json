{
    "buildCommand": "npm run build:react",
    "outputDirectory": "dist",
    "framework": null,
    "rewrites": [
        {
            "source": "/platform.map",
            "destination": "/index.html"
        },
        {
            "source": "/api/vehicles",
            "destination": "/api/vehicles.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=5"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:;"
                }
            ]
        }
    ]
}